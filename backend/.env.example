NODE_ENV=development
PORT=5000

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=replace-with-your-supabase-secret-key
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
INITIAL_ADMIN_PASSWORD=replace-with-a-unique-secret-at-least-16-characters
# Set only for a one-time migration from the old bootstrap password, then remove.
LEGACY_ADMIN_PASSWORD=
FRONTEND_URL=http://localhost:10000
BACKEND_URL=http://localhost:5000

FAST2SMS_API_KEY=replace-with-your-fast2sms-api-key
SMS_TEST_MODE=false
EMAIL_TEST_MODE=true
SMS_TEST_NUMBERS=9876543210
RESEND_API_KEY=replace-with-your-resend-api-key
EMAIL_FROM=noreply@atelimarket.shop

PAYU_MERCHANT_KEY=replace-with-your-payu-merchant-key
PAYU_SALT=replace-with-your-payu-salt
PAYU_BASE_URL=https://test.payu.in/_payment

META_PIXEL_ID=
META_ACCESS_TOKEN=
META_GRAPH_API_VERSION=v22.0
# Optional: set only while validating events in Meta Events Manager.
META_TEST_EVENT_CODE=
